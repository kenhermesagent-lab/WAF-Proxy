# Copy to deploy/.env and adjust. Never commit the real file.
# Running without Docker? Use deploy/wafproxy.env.example for the systemd unit instead.
VERSION=1.16.1
TZ=Europe/London
WAFPROXY_LOG_LEVEL=info

# First-boot listeners. The wizard stores the real WAN/LAN addresses in the
# database and those replace these values on the next start; they are only the
# fallback when no address is stored or the stored one is absent from the host.
#
# Put this host's actual LAN address here, for example 192.168.1.10:8080. The
# admin console (setup wizard, then the dashboard) listens there and is never
# bound to the WAN address. Left as loopback, the console is reachable only from
# this host (or through an SSH tunnel).
# 8080 is the console port; 8443 below is the first-boot proxy port and moves to
# 443 once the wizard has stored the WAN address.
WAFPROXY_LISTEN_GUI=127.0.0.1:8080
WAFPROXY_LISTEN_WAN=:8443

# Refuse console requests that do not come from a private network address, even
# if the listener is bound more widely than intended. On by default; only set it
# to false when something you control terminates the console.
WAFPROXY_GUI_PRIVATE_ONLY=true

# CIDRs of reverse proxies or tunnels that may name the client in
# X-Forwarded-For, for example 172.18.0.0/16 or 127.0.0.1. Empty means nothing is
# trusted and the socket peer is always the client, which is the right answer
# for a directly reachable host.
WAFPROXY_TRUSTED_PROXIES=

# Requests buffered at once. Each one may hold up to the body limit (8 MiB), so
# this is the ceiling on request memory. Requests past it get 503 and the count
# is shown on the dashboard.
WAFPROXY_MAX_INFLIGHT=128

# Optional CrowdSec bouncer (start the stack with --profile crowdsec).
# Create the key once: docker exec crowdsec cscli bouncers add wafproxy
WAFPROXY_CROWDSEC_URL=http://127.0.0.1:8081
WAFPROXY_CROWDSEC_KEY=

# Optional static token for the /mcp agent gateway. Prefer a token created on the
# AI Agent Access page; leave this empty to use only console-issued tokens. If set,
# it must be at least 32 characters. The actor name appears in the audit log.
WAFPROXY_MCP_TOKEN=
WAFPROXY_MCP_ACTOR=hermes-agent

# Streaming forwarders. The GUI (Streaming page) writes these keys when it can
# see this file; host networking needs no port publishing, so they document the
# current setting rather than feed compose. Set WAFPROXY_ENV_FILE in the
# container if the GUI should reach the file at a different path.
PLEX_ENABLED=0
PLEX_PORT=32400
PLEX_LISTEN_IP=127.0.0.1
PLEX_UPSTREAM=172.16.0.10:32400

JELLYFIN_ENABLED=0
JELLYFIN_PORT=8096
JELLYFIN_LISTEN_IP=127.0.0.1
JELLYFIN_UPSTREAM=172.16.0.11:8096
