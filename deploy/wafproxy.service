[Unit]
Description=WAF-Proxy reverse proxy and admin console
Documentation=https://github.com/kenhermesagent-lab/WAF-Proxy
After=network-online.target nftables.service tailscaled.service wafproxy-updates.service
Wants=network-online.target wafproxy-updates.service

[Service]
Type=simple
User=wafproxy
Group=wafproxy
WorkingDirectory=/var/lib/waf-proxy/data
EnvironmentFile=-/etc/wafproxy/wafproxy.env
Environment=WAFPROXY_DATA_DIR=/var/lib/waf-proxy/data
Environment=WAFPROXY_ACCESS_LOG=/var/log/wafproxy/access.log
Environment=HOME=/var/lib/waf-proxy/data
ExecStart=/var/lib/waf-proxy/bin/wafproxy
Restart=always
RestartSec=5
TimeoutStopSec=15
UMask=0027

# Bind 443 and manage the nftables ban set without running as root. The same
# capabilities must be in the bounding and ambient sets; the nft child process
# inherits the ambient set, so kernel-mode bans work too.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

# The install root /var/lib/waf-proxy holds the program files (bin, lib, src)
# and the state (data/). Only data/ and the CrowdSec access log are writable;
# the binaries and the update checkout stay read-only to the service.
LogsDirectory=wafproxy
LogsDirectoryMode=0750
ProtectSystem=strict
# The app only connects to the helper socket; this keeps /run writable enough
# for that socket even when the helper starts after the app.
ReadWritePaths=/var/lib/waf-proxy/data
ReadWritePaths=-/run/wafproxy-updates
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=multi-user.target
