[Unit]
Description=WAF-Proxy privileged host update helper
Documentation=https://github.com/kenhermesagent-lab/WAF-Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/var/lib/waf-proxy/bin/wafproxy-updated --socket /run/wafproxy-updates/updates.sock
RuntimeDirectory=wafproxy-updates
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
User=root
Group=root

# apt needs to write /etc, /var/lib/dpkg, /var/lib/apt and the package cache.
# The helper itself has no network listener and accepts only the compiled
# package allowlist over a root:wafproxy 0660 Unix socket.
# The managed checkout lives in /var/lib/waf-proxy/src, but an older install may
# still record a checkout under /home, so keep it reachable.
ProtectHome=no
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
