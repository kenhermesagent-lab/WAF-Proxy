# Environment for the systemd unit, installed as /etc/wafproxy/wafproxy.env.
# Docker Compose users configure deploy/.env instead; this file is not read by
# the container.
#
# First-boot listeners. install.sh asks for the WAN/LAN interfaces and writes
# concrete addresses here, so the GUI is bound to the LAN interface only from
# the first start. The wizard receives the same addresses prefilled and stores
# them in the database; those replace these values on the next start.
#
# Manual installs that do not run install.sh can keep the loopback defaults and
# use an SSH tunnel to reach the wizard.
WAFPROXY_LISTEN_GUI=127.0.0.1:8080
WAFPROXY_LISTEN_WAN=127.0.0.1:8443

# Interface names reported by the native installer. The wizard copies them into
# the database so the dashboard and stealth rules sample the right links.
WAFPROXY_WAN_IFACE=
WAFPROXY_LAN_IFACE=

# Refuse admin-console clients outside RFC1918 and loopback. install.sh enables
# this; loopback stays allowed for an SSH tunnel and local health checks.
WAFPROXY_GUI_PRIVATE_ONLY=true

WAFPROXY_LOG_LEVEL=info

# Optional static bearer token for the /mcp agent gateway. Console-issued tokens
# on the Agent access page are preferred and work with this left empty. If set,
# it must be at least 32 characters; WAFPROXY_MCP_ACTOR is the audit name.
# WAFPROXY_MCP_TOKEN=
WAFPROXY_MCP_ACTOR=hermes-agent

# Optional: supply the 32-byte master key as base64 instead of keeping it in
# /var/lib/waf-proxy/data/master.key.
# WAFPROXY_MASTER_KEY=

# Optional CrowdSec bouncer. Create the key with `cscli bouncers add wafproxy`.
WAFPROXY_CROWDSEC_URL=
WAFPROXY_CROWDSEC_KEY=
